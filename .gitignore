# ===== 本地环境 / 工具缓存（不上传）=====
.workbuddy-ai/
.gradle-home/
firmware/.idf-component-cache/
firmware/.build-tmp/
android/.gradle/
android/local.properties

# ===== 构建产物 =====
firmware/xiaozhi-esp32/build/
firmware/xiaozhi-esp32/managed_components/
firmware/xiaozhi-esp32/dependencies.lock
android/build/
android/app/build/
output/0a5714d2-*/
# output/ 是暂存/交付目录，里面的 APK 是构建产物（7.5MB），别进仓库；
# 真要归档某个版本用 git tag + 重新构建，不要塞二进制。
output/*.apk

# ===== 上游只读参考（19MB，与原项目重复；上游版本记录在 README）=====
vendor/

# ===== 其它 =====
*.log
*.tmp
.DS_Store
__pycache__/

# ===== 智能体本地工作区（记忆/日志，不属于代码）=====
.workbuddy/
