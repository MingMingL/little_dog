<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        NoActionBar：自带的 ActionBar 高度约 184px，会压住首页"设备 IP / 刷新 / 设置"那行
        （targetSdk 36 在 Android 15 edge-to-edge 下更明显），所以关掉。
        内容里的首行自己当头部；设置页有内嵌标题 TextView，不需要 ActionBar。
    -->
    <style name="Theme.AiDogControl" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
        遥控方向按钮的共用样式：三个一行，等宽。
        宽高在元素上还会再显式写一遍 —— 布局里漏写 layout_width/height 是
        aapt 构建期不检查、只有 inflate 时才炸的错误，双写最稳。
    -->
    <style name="RemoteButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
    </style>
</resources>
