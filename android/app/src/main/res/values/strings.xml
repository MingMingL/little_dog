    <string name="msg_summon_mode_rejected">召唤进行中，不能切换模式（急停除外）</string>
    <string name="msg_summon_requires_word">召唤模式只能由唤醒词+口令进入</string>
    <string name="msg_vision_off">摄像头确认已关闭：到达判定改用纯声学</string>
    <string name="msg_vision_on">摄像头确认已开启</string>
