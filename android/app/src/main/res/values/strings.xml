    <!-- 召唤（V1.5） -->
    <string name="hint_summon">召唤：对设备说唤醒词“你好小智”，再说口令“过来/到这里来”，
        设备会判断方向并开到你面前。召唤优先级高于巡逻/看门/遥控，仅急停可中断。</string>
    <string name="label_summon_phase">召唤阶段</string>
